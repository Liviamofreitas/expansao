# =============================================================================
# SGDF — variáveis de ambiente. COPIE para .env e preencha; NÃO comite o .env.
#
# NENHUM SEGREDO VIVE AQUI NEM NO application.yaml (cap. 15). Em produção estes
# valores vêm do cofre, injetados pelo orquestrador; este arquivo existe para
# dizer QUAIS são, não para guardá-los.
# =============================================================================

# --- banco -------------------------------------------------------------------
SGDF_JDBC_URL=jdbc:postgresql://localhost:5432/sgdf
SGDF_JDBC_USUARIO=sgdf_app
SGDF_JDBC_SENHA=                 # cofre
SGDF_POOL=10

# --- identidade (cap. 14.4) --------------------------------------------------
# O IdP corporativo. MFA é exigido dele nos papéis com acesso a escopo
# profissional; o SGDF confia no token e autoriza por papel (cap. 15.1).
SGDF_OIDC_ISSUER=https://idp.engesoftware.example/realms/corporativo

# --- origem dos documentos (cap. 14.1) ---------------------------------------
SGDF_WEBDAV_BASE=https://owncloud.engesoftware.example/remote.php/dav/files/svc-sgdf-leitura
SGDF_WEBDAV_USUARIO=svc-sgdf-leitura
SGDF_WEBDAV_SENHA=               # cofre; conta SOMENTE-LEITURA, rotação 90 dias

# --- antivírus (SEC-05) ------------------------------------------------------
SGDF_CLAMD_HOST=clamd
SGDF_CLAMD_PORTA=3310

# --- identificação da instância (SEC-10 / RA-07) -----------------------------
# Com duas réplicas, é o que diz qual delas parou de executar os jobs.
SGDF_INSTANCIA=sgdf-01
SGDF_PORTA=8080
