<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>br.com.engesoftware</groupId>
  <artifactId>sgdf</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <name>SGDF — Sistema de Gestão Documental do Faturamento</name>

  <!--
    ADR-001 fixou Java 21 + Spring Boot.

    Toda dependência entra com versão FIXADA — nunca faixa nem SNAPSHOT — porque
    o gate SEC-07 exige SCA reprodutível e o ambiente-alvo é offline (D-06): o
    espelho Maven interno precisa saber exatamente o que espelhar.

    Ainda não declarados, na ordem em que devem entrar:
      1. spring-boot-starter-parent como <parent>, com a versão fixada;
      2. junit-jupiter e surefire, migrando os executores próprios de src/test;
      3. tess4j ou wrapper equivalente para Tesseract (contingência de OCR do
         cap. 8.2 — a porta ExtratorDeTexto já prevê o encaixe);
      4. poi-ooxml para planilhas (cap. 8.2: leitura direta de células);
      5. flyway-core, substituindo db/aplicar.sh;
      6. spring-boot-starter-oauth2-resource-server (OIDC — história F0-01).
  -->

  <properties>
    <maven.compiler.release>21</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
  </properties>

  <dependencies>
    <!-- História F1-02: extração de texto COM POSIÇÕES. PDFBox é a razão
         técnica da escolha de stack registrada em ADR-001: writeString entrega
         a lista de TextPosition por glifo, que é o que sustenta o critério de
         aceite ("campos extraídos exibem a região de origem"). -->
    <dependency>
      <groupId>org.apache.pdfbox</groupId>
      <artifactId>pdfbox</artifactId>
      <version>3.0.3</version>
    </dependency>
  </dependencies>

  <build>
    <sourceDirectory>src/main/java</sourceDirectory>
    <testSourceDirectory>src/test/java</testSourceDirectory>
  </build>
</project>
